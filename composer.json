{
    "name": "touhidurabir/envlens",
    "description": "Inspect, compare, audit and safely maintain Laravel .env files.",
    "keywords": ["laravel", "env", "dotenv", "audit", "environment"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Touhidur Rahman",
            "email": "abircse06@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "laravel/prompts": "^0.3",
        "nikic/php-parser": "^5.0",
        "nunomaduro/termwind": "^2.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Touhidurabir\\EnvLens\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Touhidurabir\\EnvLens\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage --min=90",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Touhidurabir\\EnvLens\\EnvLensServiceProvider"
            ],
            "aliases": {
                "EnvLens": "Touhidurabir\\EnvLens\\Facades\\EnvLens"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
